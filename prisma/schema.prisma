generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin_master
  lojista_admin
  atendente
}

enum LeadStatus {
  balde_geral
  aguardando_resposta
  em_atendimento
  finalizado
}

enum SubscriptionStatus {
  ativo
  inativo
  trial
}

enum MessageStatus {
  enviado
  entregue
  lido
  erro
}

enum MessageDirection {
  entrada
  saida
}

enum DmCampanhaStatus {
  rascunho
  agendada
  em_andamento
  concluida
  pausada
  aguardando_recarga
  aguardando_pagamento
}

enum InvoiceStatus {
  pendente
  pago
  expirado
  cancelado
}

enum DmCampanhaTipo {
  proprio
  dripfy
}

enum DmCampanhaPrioridade {
  baixa
  media
  alta
}

enum DmFinanceiroStatus {
  pendente
  pago
}

enum DmMidiaTipo {
  nenhuma
  imagem
  video
}

enum CreditoTransacaoTipo {
  compra
  consumo
  ajuste
}

enum DmContatoStatus {
  pendente
  enviando
  enviado
  entregue
  lido
  falha
}

model Tenant {
  id                  String             @id @default(uuid())
  nome_empresa        String
  slug                String             @unique
  status_assinatura   SubscriptionStatus @default(trial)
  creditos_saldo      Int                @default(0)
  criado_em           DateTime           @default(now())
  atualizado_em       DateTime           @updatedAt

  // ─── Assinatura mensal por usuários (seats) ─────────────────────────────
  // Pacote Start: usuarios_inclusos (1 admin + 2 vendedores) por
  // valor_mensalidade_base; cada usuário além disso soma valor_usuario_adicional.
  usuarios_inclusos       Int      @default(3)
  valor_mensalidade_base  Decimal  @default(300.00) @db.Decimal(10, 2)
  valor_usuario_adicional Decimal  @default(50.00) @db.Decimal(10, 2)
  proxima_cobranca_em     DateTime?
  assinatura_bloqueada    Boolean  @default(false)

  users               User[]
  chatwoot_config     ChatwootConfig?
  leads               Lead[]
  messages            Message[]
  etiquetas           Etiqueta[]
  dm_canais           DmCanal[]
  dm_campanhas        DmCampanha[]
  bm_tokens           BmToken[]
  quick_replies       QuickReply[]
  lead_activities     LeadActivity[]
  invoices            Invoice[]
  dm_modelos_mensagem DmModeloMensagem[]
  credito_transacoes  CreditoTransacao[]
  mensalidade_faturas MensalidadeFatura[]

  @@map("tenants")
}

enum MensalidadeFaturaStatus {
  pendente
  pago
  cancelado
}

model MensalidadeFatura {
  id                String                  @id @default(uuid())
  tenant_id         String
  competencia       String // "2026-07" (ano-mês de referência da cobrança)
  usuarios_cobrados Int
  usuarios_extras   Int
  valor_total       Decimal                 @db.Decimal(10, 2)
  status            MensalidadeFaturaStatus @default(pendente)
  vencimento        DateTime
  pago_em           DateTime?
  pix_qrcode_base64 String?                 @db.Text
  pix_copia_cola    String?                 @db.Text
  criado_em         DateTime                @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, competencia])
  @@index([tenant_id, criado_em])
  @@map("mensalidade_faturas")
}

model Invoice {
  id                   String        @id @default(uuid())
  tenant_id            String
  quantidade_creditos  Int
  valor_total          Decimal       @db.Decimal(10, 2)
  status               InvoiceStatus @default(pendente)
  gateway              String
  gateway_payment_id   String?       @unique
  pix_qrcode_base64    String?       @db.Text
  pix_copia_cola       String?       @db.Text
  criado_em            DateTime      @default(now())
  pago_em              DateTime?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([status])
  @@map("invoices")
}

// ─── Conta corrente de créditos do parceiro (extrato) ──────────────────────
model CreditoTransacao {
  id          String               @id @default(uuid())
  tenant_id   String
  tipo        CreditoTransacaoTipo
  quantidade  Int                  // positivo = entrada (compra), negativo = saída (consumo)
  saldo_apos  Int                  // saldo do tenant logo após esta transação
  descricao   String
  campanha_id String?
  invoice_id  String?
  criado_em   DateTime             @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, criado_em])
  @@map("credito_transacoes")
}

model User {
  id            String    @id @default(uuid())
  tenant_id     String
  nome          String
  email         String
  password_hash String
  role          UserRole  @default(atendente)
  ativo         Boolean   @default(true)
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  leads_vendedor  Lead[]    @relation("LeadVendedor")
  campanhas_vendedor DmCampanha[] @relation("DmCampanhaVendedor")

  @@unique([tenant_id, email])
  @@map("users")
}

model ChatwootConfig {
  id                  String   @id @default(uuid())
  tenant_id           String   @unique
  chatwoot_url        String
  chatwoot_api_token  String
  criado_em           DateTime @default(now())
  atualizado_em       DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("chatwoot_configs")
}

model Etiqueta {
  id              String   @id @default(uuid())
  tenant_id       String
  nome            String
  cor_hexadecimal String   @default("#6B7280")
  ordem           Int      @default(0)
  slug            String?
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  leads        Lead[] @relation("LeadEtiquetaLegacy")
  leads_multi  Lead[] @relation("LeadEtiquetas")

  @@unique([tenant_id, slug])
  @@index([tenant_id, ordem])
  @@map("etiquetas")
}

model QuickReply {
  id            String   @id @default(uuid())
  tenant_id     String
  titulo        String
  texto         String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("quick_replies")
}

model BmToken {
  id            String   @id @default(uuid())
  tenant_id     String
  nome          String
  token         String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("bm_tokens")
}

model Lead {
  id_number     Int        @id @default(autoincrement())
  id_uuid       String     @default(uuid())
  tenant_id     String
  cpf           String?
  nome          String
  telefone      String
  status_atual  LeadStatus @default(balde_geral)
  etiqueta_id   String?
  vendedor_id   String?
  disparado               Boolean    @default(false)
  iniciado_pelo_cliente   Boolean    @default(false)
  last_message_at      DateTime?
  last_message_preview String?
  unread_count          Int       @default(0)
  origem_campanha_id    String?
  origem_campanha_nome  String?
  criado_em     DateTime   @default(now())
  atualizado_em DateTime   @updatedAt

  tenant        Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  etiqueta      Etiqueta?     @relation("LeadEtiquetaLegacy", fields: [etiqueta_id], references: [id], onDelete: SetNull)
  etiquetas     Etiqueta[]    @relation("LeadEtiquetas")
  vendedor      User?         @relation("LeadVendedor", fields: [vendedor_id], references: [id], onDelete: SetNull)
  origem_campanha DmCampanha? @relation(fields: [origem_campanha_id], references: [id], onDelete: SetNull)
  messages      Message[]
  activities    LeadActivity[]

  @@unique([tenant_id, cpf])
  @@index([tenant_id, status_atual])
  @@index([tenant_id, etiqueta_id])
  @@index([tenant_id, disparado])
  @@index([tenant_id, last_message_at])
  @@map("leads")
}

model Message {
  id            String        @id @default(uuid())
  tenant_id     String
  canal_id      String?
  lead_id       Int
  wamid         String?          @unique
  template_name String?
  direction     MessageDirection @default(saida)
  content       String?
  media_url       String?
  media_mime_type String?
  status        MessageStatus    @default(enviado)
  erro_msg      String?
  criado_em     DateTime      @default(now())
  atualizado_em DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lead          Lead          @relation(fields: [lead_id], references: [id_number], onDelete: Cascade)

  @@index([lead_id])
  @@index([tenant_id])
  @@index([wamid])
  @@map("messages")
}

model LeadActivity {
  id        String   @id @default(uuid())
  tenant_id String
  lead_id   Int
  texto     String
  criado_em DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [lead_id], references: [id_number], onDelete: Cascade)

  @@index([lead_id])
  @@map("lead_activities")
}

// ─── Disparo em Massa (canais oficiais Meta + campanhas em lote) ───────────

model DmCanal {
  id                String   @id @default(uuid())
  tenant_id         String
  nome              String
  waba_id           String
  phone_number_id   String
  access_token      String
  bm_nome           String?
  lote_size         Int?
  delay_ms          Int?
  template_boas_vindas String?
  chatwoot_inbox_id Int?
  ativo             Boolean  @default(true)
  criado_em         DateTime @default(now())

  tenant     Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  campanhas  DmCampanha[]

  @@index([tenant_id])
  @@index([tenant_id, phone_number_id])
  @@map("dm_canais")
}

model DmCampanha {
  id                String            @id @default(uuid())
  tenant_id         String
  canal_id          String?
  vendedor_id       String?
  nome              String
  template_name     String?
  template_params   Json?             @default("[]")
  header_image_url  String?
  status            DmCampanhaStatus  @default(rascunho)
  agendado_para     DateTime?
  total_contatos    Int               @default(0)
  enviados          Int               @default(0)
  entregues         Int               @default(0)
  falhas            Int               @default(0)
  criado_em         DateTime          @default(now())
  iniciado_em       DateTime?

  // ─── Disparo Dripfy (demanda manual, executada via JMD) ─────────────────
  tipo              DmCampanhaTipo       @default(proprio)
  prioridade        DmCampanhaPrioridade @default(media)
  financeiro_status DmFinanceiroStatus?
  mensagem_texto    String?
  link_botao        String?
  foto_perfil_url   String?
  midia_tipo        DmMidiaTipo?
  midia_url         String?
  aprovado_em       DateTime?
  aprovado_por      String?

  tenant    Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  canal     DmCanal?     @relation(fields: [canal_id], references: [id], onDelete: SetNull)
  vendedor  User?        @relation("DmCampanhaVendedor", fields: [vendedor_id], references: [id], onDelete: SetNull)
  contatos  DmContato[]
  leads_origem Lead[]

  @@index([tenant_id, status])
  @@index([tipo, financeiro_status])
  @@map("dm_campanhas")
}

model DmModeloMensagem {
  id         String   @id @default(uuid())
  tenant_id  String
  nome       String
  texto      String
  link_botao String?
  criado_em  DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("dm_modelos_mensagem")
}

model DmContato {
  id           String           @id @default(uuid())
  campanha_id  String
  nome         String?
  cpf          String?
  telefone     String
  status       DmContatoStatus  @default(pendente)
  enviado_em   DateTime?
  erro         String?
  message_id   String?
  criado_em    DateTime         @default(now())

  campanha  DmCampanha @relation(fields: [campanha_id], references: [id], onDelete: Cascade)

  @@index([campanha_id])
  @@index([campanha_id, status])
  @@index([message_id])
  @@map("dm_contatos")
}
